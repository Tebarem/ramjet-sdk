<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDK's leak check (sdk/README.md): the stripped Mc.Scripting.Api must be public API only, identical in surface to the real
       assemblies, and ship only the XML docs of that surface. Built and run by Ramjet.Api.csproj when it packs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

</Project>
